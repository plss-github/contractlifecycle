<div class="clc-services">
   <ul class="nav nav-tabs mb-3 clc-subtabs" role="tablist">
      <li class="nav-item">
         <button class="nav-link active" type="button" data-clc-subtab="#clc-srv-list-{{ rand }}">
            {{ __('Contratados', 'contractlifecycle') }} <span class="badge bg-secondary-lt ms-1">{{ rows|length }}</span>
         </button>
      </li>
      {% if can_edit %}
         <li class="nav-item">
            <button class="nav-link" type="button" data-clc-subtab="#clc-srv-add-{{ rand }}">
               <i class="ti ti-plus"></i> {{ __('Adicionar', 'contractlifecycle') }}
            </button>
         </li>
      {% endif %}
   </ul>

   <div class="clc-subpanes">
      <div class="clc-subpane is-active" id="clc-srv-list-{{ rand }}">
         {% if roots is not empty %}
            <div class="alert alert-info py-2">
               <i class="ti ti-info-circle me-1"></i>
               {{ __('Pelas regras do contrato, ele também cobre toda categoria com raiz: %s', 'contractlifecycle')|format(roots|join(', ')) }}
            </div>
         {% endif %}
         {% if rows is empty %}
            <div class="text-muted p-3">{{ __('Nenhum serviço vinculado a este contrato.', 'contractlifecycle') }}</div>
         {% else %}
            <form method="post" action="{{ action }}">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <input type="hidden" name="contracts_id" value="{{ contracts_id }}">
               <div class="mb-2">
                  <input type="search" class="form-control form-control-sm w-auto" data-clc-filter="#clc-srv-table-{{ rand }}"
                         placeholder="{{ __('Filtrar...', 'contractlifecycle') }}">
               </div>
               <table class="table table-hover table-sm card-table" id="clc-srv-table-{{ rand }}">
                  <thead>
                     <tr>
                        {% if can_edit %}<th style="width: 2rem"><input type="checkbox" class="form-check-input" data-clc-checkall></th>{% endif %}
                        <th>{{ __('Serviço (categoria)', 'contractlifecycle') }}</th>
                        <th>{{ _n('Entity', 'Entities', 1) }}</th>
                     </tr>
                  </thead>
                  <tbody>
                     {% for row in rows %}
                        <tr>
                           {% if can_edit %}<td><input type="checkbox" class="form-check-input" name="item[{{ row.id }}]" value="1"></td>{% endif %}
                           <td><a href="{{ row.url }}">{{ row.name }}</a></td>
                           <td class="text-muted">{{ row.entity }}</td>
                        </tr>
                     {% endfor %}
                  </tbody>
               </table>
               {% if can_edit %}
                  <button type="submit" name="remove" class="btn btn-outline-danger btn-sm mt-2">
                     <i class="ti ti-trash"></i> {{ __('Remover selecionados', 'contractlifecycle') }}
                  </button>
               {% endif %}
            </form>
         {% endif %}
      </div>

      {% if can_edit %}
         <div class="clc-subpane" id="clc-srv-add-{{ rand }}">
            <form method="post" action="{{ action }}">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <input type="hidden" name="contracts_id" value="{{ contracts_id }}">
               <div class="row mb-3">
                  <label class="col-md-3 col-form-label text-md-end">{{ __('Categorias', 'contractlifecycle') }}</label>
                  <div class="col-md-7">{{ add_input|raw }}</div>
               </div>
               <div class="row mb-3">
                  <div class="offset-md-3 col-md-7">
                     <label class="form-check">
                        <input class="form-check-input" type="checkbox" name="with_children" value="1" checked>
                        <span class="form-check-label">{{ __('Incluir as subcategorias', 'contractlifecycle') }}</span>
                     </label>
                  </div>
               </div>
               <div class="offset-md-3">
                  <button type="submit" name="add" class="btn btn-primary"><i class="ti ti-plus"></i> {{ __('Adicionar', 'contractlifecycle') }}</button>
               </div>
            </form>
         </div>
      {% endif %}
   </div>
</div>
